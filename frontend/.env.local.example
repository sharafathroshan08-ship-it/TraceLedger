# Base URL of the FastAPI backend.
#
# Local development: point directly at Uvicorn.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production (Vercel) alternative — same-origin proxy, keeps the session cookie
# first-party:
#   NEXT_PUBLIC_API_BASE_URL=
#   TRACELEDGER_API_PROXY=https://your-service.onrender.com
